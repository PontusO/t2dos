# Makefile.board - the board tree build file, executed by /bin/make.bin.
# One target per line. The target IS its output path; leading '-' tokens are
# that target's build flags (-I takes the next token); remaining prereqs are
# sources, headers (checked now, inputs to a future timestamp pass) or other
# targets (a line whose prereq matches a defined target name resolves it).
# Each tool's source list is a variable (NAME := value; $(NAME) expands at the
# target line). Every path stays LITERAL on a definition line: the checker's
# staging tokenizer scans the RAW text for '/'-leading tokens and does not see
# $(...) tokens, so tools: and all: keep their target-name prereqs literal
# after the colon (a /src/x.bin token on a definition line would be staged as
# a source file).
# Files a source #includes (t2obj.c) are NOT prereqs: cc would get them twice
# (duplicate symbols); they are staged for the include path like headers.
# Always rebuilds: no timestamps. Checker: tools/check_make.py.
# Layout below the board root /: tool sources mirror the repo dirs under
# /src, includes and shared lib files (sys.h, basic.h) live in /lib, mirrored like the PC root/lib tree. Built binaries are byte-equal
# to the PC Makefile's root/bin/*.bin (same cc, same flags up to -I paths).
# CC_SRC below: keep in sync with the root Makefile's CC_SRC (src/compiler/*.c),
# the plan-board fixture in tools/check_make.py (it pins the expanded command
# built from this file) and src/compiler/Makefile's cc.bin line.
CCFLAGS := -I /lib
CC_SRC := /src/compiler/cc.c /src/compiler/emit.c /src/compiler/expr.c /src/compiler/fp.c /src/compiler/lex.c /src/compiler/licm.c /src/compiler/opt.c /src/compiler/regs.c /src/compiler/state.c /src/compiler/stmt.c /src/compiler/types.c /lib/cc.h /lib/sys.h
AS_SRC := /src/assembler/as.c /lib/sys.h /lib/t2obj.h
LD_SRC := /src/linker/ld.c /lib/sys.h /lib/t2obj.h
AR_SRC := /src/binutils/ar.c /lib/sys.h /lib/t2obj.h
NM_SRC := /src/binutils/nm.c /lib/sys.h /lib/t2obj.h
OD_SRC := /src/binutils/objdump.c /lib/sys.h /lib/t2obj.h
BASIC_SRC := /src/basic/comp.c /src/basic/fmt.c /src/basic/funcs.c /src/basic/io.c /src/basic/lex.c /src/basic/main.c /src/basic/vm.c /lib/basic.h
SH_SRC := /src/userland/sh.c /lib/sys.h
/src/cc.bin: $(CCFLAGS) $(CC_SRC)
/src/as.bin: $(CCFLAGS) $(AS_SRC)
/src/ld.bin: $(CCFLAGS) $(LD_SRC)
/src/ar.bin: $(CCFLAGS) $(AR_SRC)
/src/nm.bin: $(CCFLAGS) $(NM_SRC)
/src/objdump.bin: $(CCFLAGS) $(OD_SRC)
/src/basic.bin: $(CCFLAGS) $(BASIC_SRC)
/src/sh.bin: $(CCFLAGS) $(SH_SRC)
tools: /src/cc.bin /src/as.bin /src/ld.bin /src/ar.bin /src/nm.bin /src/objdump.bin
all: tools /src/basic.bin /src/sh.bin
